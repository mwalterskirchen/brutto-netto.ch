---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator';
import Faq from '../components/Faq.astro';

const explainers = [
  {
    name: 'Nettolohn',
    title: 'Was auf Ihr Konto kommt',
    text: 'Der Bruttolohn minus alle Abzüge, vor Steuern.',
    color: 'bg-note-20',
  },
  {
    name: 'AHV/IV/EO',
    title: 'Alters- und Hinterlassenenversicherung, Invalidenversicherung, Erwerbsersatzordnung',
    text: '5.3% des ganzen Bruttolohns.',
    color: 'bg-note-100',
  },
  {
    name: 'BVG',
    title: 'Pensionskasse, 2. Säule',
    text: 'Je nach Alter 0.8% bis 10.1% des koordinierten Lohns. Unter einem Jahreslohn von CHF 22’680 fällt der Beitrag weg.',
    color: 'bg-note-1000',
  },
  {
    name: 'ALV',
    title: 'Arbeitslosenversicherung',
    text: '1.1% bis zu einem Jahreslohn von CHF 148’200, auf dem Teil darüber 0.5%.',
    color: 'bg-note-10',
  },
  {
    name: 'NBU',
    title: 'Nichtberufsunfallversicherung',
    text: 'Rund 1%. Der genaue Satz hängt von der Versicherung Ihres Arbeitgebers ab.',
    color: 'bg-note-50',
  },
  {
    name: 'KTG',
    title: 'Krankentaggeldversicherung',
    text: 'Rund 0.8%. Optional, nur wenn Ihr Arbeitgeber einen Teil der Prämie vom Lohn abzieht.',
    color: 'bg-note-200',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Brutto Netto Rechner Schweiz',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description:
    '100% privater Open Source Lohnrechner für die Schweiz. Berechnen Sie Ihren Nettolohn aus dem Bruttolohn mit allen Sozialversicherungsabzügen (AHV, IV, EO, ALV, BVG, NBU) für 2026. Alle Berechnungen finden ausschliesslich in Ihrem Browser statt – Ihre Daten werden niemals an einen Server übertragen.',
  isAccessibleForFree: true,
  inLanguage: 'de-CH',
  url: 'https://brutto-netto.ch',
  author: {
    '@type': 'Person',
    name: 'Maximilian Walterskirchen',
  },
  codeRepository: 'https://github.com/mwalterskirchen/brutto-netto.ch',
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
};
---

<Layout
  title="Brutto Netto Rechner Schweiz 2026 - 100% Privat & Open Source Lohnrechner"
  description="100% privater Open Source Brutto Netto Rechner Schweiz 2026: Berechnen Sie Ihren Nettolohn mit allen AHV, IV, ALV, BVG Abzügen. Alle Daten bleiben in Ihrem Browser – transparent & sicher!"
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="brutto netto rechner schweiz, lohnrechner schweiz, gehaltsrechner schweiz, nettolohn berechnen, open source lohnrechner, privater gehaltsrechner, datenschutz, AHV rechner, lohnabzüge schweiz 2026"
    />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Brutto Netto Rechner Schweiz 2026 - 100% Privat & Open Source"
    />
    <meta
      property="og:description"
      content="Berechnen Sie Ihren Nettolohn transparent und sicher. Alle Berechnungen im Browser, keine Datenübertragung. Open Source auf GitHub verfügbar."
    />
    <meta property="og:url" content="https://brutto-netto.ch" />
    <meta property="og:image" content="https://brutto-netto.ch/og_image.png" />
    <meta
      property="og:image:alt"
      content="Brutto Netto Rechner Schweiz - 100% Privat & Open Source"
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_CH" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Brutto Netto Rechner Schweiz 2026 - 100% Privat & Open Source"
    />
    <meta
      name="twitter:description"
      content="Transparenter Lohnrechner für die Schweiz. Alle Berechnungen im Browser, keine Datenübertragung. Open Source auf GitHub."
    />
    <meta name="twitter:image" content="https://brutto-netto.ch/og_image.png" />
    <meta
      name="twitter:image:alt"
      content="Brutto Netto Rechner Schweiz - 100% Privat & Open Source"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <div class="mb-8 sm:mb-10">
    <h1 class="text-4xl leading-[1.02] font-extrabold sm:text-5xl lg:text-[3.5rem]">
      Brutto Netto Rechner Schweiz 2026
    </h1>
    <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
      <p class="max-w-[62ch] text-lg leading-relaxed text-pretty">
        Wie viel bleibt von Ihrem Lohn? Der Rechner zieht AHV, IV, EO, ALV, BVG, NBU und KTG ab. Er
        läuft nur in Ihrem Browser, Ihre Angaben verlassen das Gerät nie.
      </p>
      <ul class="flex shrink-0 flex-wrap gap-2 text-sm font-heading" aria-label="Eigenschaften">
        <li class="rounded-base border-2 border-border bg-secondary-background px-3 py-1">
          100% privat
        </li>
        <li class="rounded-base border-2 border-border bg-secondary-background px-3 py-1">
          Open Source
        </li>
        <li class="rounded-base border-2 border-border bg-secondary-background px-3 py-1">
          Kostenlos
        </li>
      </ul>
    </div>
  </div>

  <Calculator client:load />

  <section class="mt-20" aria-labelledby="deductions-title">
    <h2 id="deductions-title" class="text-2xl sm:text-3xl">
      So rechnet der Rechner
    </h2>
    <p class="mt-4 max-w-[68ch] text-lg leading-relaxed">
      Der Rechner zieht vom <strong>Bruttolohn</strong> alle Sozialversicherungsbeiträge ab, die
      Arbeitnehmende in der Schweiz bezahlen. Was übrig bleibt, ist der <strong>Nettolohn</strong>.
      Die Beitragssätze sind in allen Kantonen gleich, ob Zürich, Basel, Bern, Luzern, St.Gallen
      oder Genf. Steuern zieht der Rechner nicht ab, weil sie je nach Kanton und Gemeinde anders
      sind.
    </p>
    <dl class="mt-8 grid overflow-hidden rounded-base border-2 border-border bg-secondary-background shadow-shadow sm:grid-cols-2 lg:grid-cols-3">
      {explainers.map(({ name, title, text, color }) => (
        <div class="-mt-[2px] -ml-[2px] border-t-2 border-l-2 border-border p-5">
          <dt class="flex items-center gap-3">
            <span
              aria-hidden="true"
              class={`size-4 shrink-0 rounded-[3px] border-2 border-border ${color}`}
            />
            <span class="font-wide text-lg font-bold">{name}</span>
          </dt>
          <dd class="mt-2">
            <span class="block font-heading">{title}</span>
            <span class="mt-1 block text-foreground/75 leading-relaxed">{text}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <Faq />
</Layout>
