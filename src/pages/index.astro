---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator';
import Faq from '../components/Faq.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Brutto Netto Rechner Schweiz',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description:
    '100% privater Open Source Lohnrechner für die Schweiz. Berechnen Sie Ihren Nettolohn aus dem Bruttolohn mit allen Sozialversicherungsabzügen (AHV, IV, EO, ALV, BVG, NBU) für 2026. Alle Berechnungen finden ausschliesslich in Ihrem Browser statt – Ihre Daten werden niemals an einen Server übertragen.',
  isAccessibleForFree: true,
  inLanguage: 'de-CH',
  url: 'https://brutto-netto.ch',
  author: {
    '@type': 'Person',
    name: 'Maximilian Walterskirchen',
  },
  codeRepository: 'https://github.com/mwalterskirchen/brutto-netto.ch',
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
};
---

<Layout
  title="Brutto Netto Rechner Schweiz 2026 - 100% Privat & Open Source Lohnrechner"
  description="100% privater Open Source Brutto Netto Rechner Schweiz 2026: Berechnen Sie Ihren Nettolohn mit allen AHV, IV, ALV, BVG Abzügen. Alle Daten bleiben in Ihrem Browser – transparent & sicher!"
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="brutto netto rechner schweiz, lohnrechner schweiz, gehaltsrechner schweiz, nettolohn berechnen, open source lohnrechner, privater gehaltsrechner, datenschutz, AHV rechner, lohnabzüge schweiz 2026"
    />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Brutto Netto Rechner Schweiz 2026 - 100% Privat & Open Source"
    />
    <meta
      property="og:description"
      content="Berechnen Sie Ihren Nettolohn transparent und sicher. Alle Berechnungen im Browser, keine Datenübertragung. Open Source auf GitHub verfügbar."
    />
    <meta property="og:url" content="https://brutto-netto.ch" />
    <meta property="og:image" content="https://brutto-netto.ch/og_image.png" />
    <meta
      property="og:image:alt"
      content="Brutto Netto Rechner Schweiz - 100% Privat & Open Source"
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_CH" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Brutto Netto Rechner Schweiz 2026 - 100% Privat & Open Source"
    />
    <meta
      name="twitter:description"
      content="Transparenter Lohnrechner für die Schweiz. Alle Berechnungen im Browser, keine Datenübertragung. Open Source auf GitHub."
    />
    <meta name="twitter:image" content="https://brutto-netto.ch/og_image.png" />
    <meta
      name="twitter:image:alt"
      content="Brutto Netto Rechner Schweiz - 100% Privat & Open Source"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Calculator client:load />

  <section class="max-w-4xl mx-auto mt-12 mb-8 prose prose-sm">
    <h2 class="text-2xl font-bold mb-4">So funktioniert's</h2>
    <p>
      Der <strong>Brutto Netto Rechner</strong> ist ein kostenloser Online-Lohnrechner und
      Gehaltsrechner für die Schweiz. Er berechnet präzise Ihren <strong>Nettolohn</strong> aus dem
      <strong>Bruttolohn</strong> unter Berücksichtigung aller relevanten Schweizer Abzüge.
    </p>
    <p>Unser Rechner berücksichtigt folgende Sozialversicherungsabzüge:</p>
    <ul class="list-disc pl-6 mb-4">
      <li>
        <strong>AHV/IV/EO</strong> (Alters- und Hinterlassenenversicherung, Invalidenversicherung,
        Erwerbsersatzordnung)
      </li>
      <li>
        <strong>ALV</strong> (Arbeitslosenversicherung)
      </li>
      <li>
        <strong>BVG</strong> (Pensionskasse / 2. Säule)
      </li>
      <li>
        <strong>NBU</strong> (Nichtberufsunfallversicherung)
      </li>
      <li>
        <strong>KTG</strong> (Krankentaggeldversicherung, optional)
      </li>
    </ul>
    <p>
      Ideal für Arbeitnehmer/innen und Arbeitgeber/innen in allen Kantonen der Schweiz. Ob Zürich,
      Basel, Bern, Luzern, St.Gallen oder Genf. Der Lohnrechner ist aktuell für das Jahr
      <strong>2026</strong>
      und verwendet die neuesten Beitragssätze.
    </p>
  </section>

  <Faq />
</Layout>
