---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '@/components/ui/button';
---

<Layout
  title="Seite nicht gefunden | Brutto Netto Rechner Schweiz"
  description="Die gesuchte Seite existiert nicht."
  noindex
>
  <div class="max-w-3xl">
    <h1 class="mb-6 text-3xl sm:text-4xl">Seite nicht gefunden</h1>
    <p class="text-foreground/80 leading-relaxed mb-6">
      Die gesuchte Seite existiert nicht oder wurde verschoben.
    </p>
    <a href="/" class={buttonVariants({ size: 'lg', className: 'font-heading' })}>
      Zum Lohnrechner
    </a>
  </div>
</Layout>
