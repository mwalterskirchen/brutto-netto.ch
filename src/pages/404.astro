---
import Layout from '../layouts/Layout.astro';

const title = 'Seite nicht gefunden | Brutto Netto Rechner Schweiz';
const description = 'Diese Seite wurde nicht gefunden.';
---
<Layout title={title} description={description}>
  <div class="max-w-md mx-auto text-center py-12">
    <h2 class="text-3xl font-bold mb-4">404 · Seite nicht gefunden</h2>
    <p class="text-fg-muted mb-6">Die angeforderte Seite existiert nicht oder wurde verschoben.</p>
    <a href="/" class="inline-block px-4 py-2 rounded-lg bg-primary text-primary-fg">Zurück zur Startseite</a>
  </div>
</Layout>
