---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og_image.png', Astro.site).toString();
---
<!DOCTYPE html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Maximilian Walterskirchen" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Brutto Netto Rechner Schweiz - 100% Privat & Open Source" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_CH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-6 sm:pt-10 min-h-screen flex flex-col gap-12 sm:gap-20">
      <header class="flex items-center justify-between gap-4">
        <a href="/" aria-label="Startseite" class="flex items-center gap-2.5 no-underline">
          <img src="/mark.svg" alt="" width="28" height="28" aria-hidden="true" />
          <span class="font-mono text-sm tracking-tight text-fg">brutto-netto<span class="text-fg-muted">.ch</span></span>
        </a>
        <span class="chip" aria-label="100% in deinem Browser">
          <span class="chip-dot" aria-hidden="true"></span>
          0&nbsp;requests · local
        </span>
        <h1 class="sr-only">Brutto Netto Lohnrechner Schweiz 2026</h1>
      </header>

      <main class="flex-1 flex flex-col gap-24 sm:gap-32">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
