---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Hide the page from search engines, e.g. the 404 page. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// build.format 'file' renders pages as /index.html and /datenschutz.html; canonical URLs
// use the extensionless form that Cloudflare Pages serves.
const canonicalPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Maximilian Walterskirchen" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only rounded-base border-2 border-border bg-secondary-background px-4 py-2 font-heading focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Zum Inhalt springen
    </a>
    <div class="flex min-h-screen flex-col">
      <Header />
      <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
