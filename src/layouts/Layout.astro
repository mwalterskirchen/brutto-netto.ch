---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { messages as t } from '../lib/messages.de';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  showHero?: boolean;
}

const { title, description, canonicalPath, showHero = false } = Astro.props;
const hero = t.brand.hero;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Maximilian Walterskirchen" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_CH" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="canonical" href={canonical} />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-6 sm:pt-10 min-h-screen flex flex-col gap-12 sm:gap-20">
      <header class="flex items-center">
        <a href="/" aria-label="Startseite" class="flex items-center gap-2.5 no-underline">
          <img src="/mark.svg" alt="" width="28" height="28" aria-hidden="true" />
          <span class="font-mono text-sm tracking-tight text-fg">brutto-netto<span class="text-fg-muted">.ch</span></span>
        </a>
        {!showHero && <h1 class="sr-only">{t.brand.a11yHeading}</h1>}
      </header>

      <main class="flex-1 flex flex-col gap-16 sm:gap-24 lg:gap-32">
        {showHero && (
          <section class="flex flex-col items-start gap-3 sm:gap-4 reveal" aria-labelledby="hero-heading">
            <h1
              id="hero-heading"
              class="font-sans text-4xl sm:text-5xl md:text-6xl leading-[1.05] tracking-tight text-balance text-fg"
            >
              {hero.headline}
            </h1>
            <p class="text-fg-muted text-base sm:text-lg max-w-2xl text-balance">
              {hero.subline}
            </p>
          </section>
        )}
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
