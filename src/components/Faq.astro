---
const GITHUB_URL = 'https://github.com/mwalterskirchen/brutto-netto.ch';
const link = (text: string) =>
  `<a href="${GITHUB_URL}" target="_blank" rel="noopener" class="link link-primary">${text}</a>`;

// Answers are HTML; the FAQPage structured data uses the same answers as plain text.
const faqs = [
  {
    question: 'Was ist der Unterschied zwischen Brutto und Netto Lohn?',
    answer:
      'Der <strong>Bruttolohn</strong> ist Ihr Gehalt vor Abzügen. Der <strong>Nettolohn</strong> ist der Betrag, der nach Abzug aller Sozialversicherungsbeiträge (AHV, IV, EO, ALV, BVG, NBU) auf Ihr Bankkonto überwiesen wird.',
  },
  {
    question: 'Welche Abzüge werden in der Schweiz vom Lohn abgezogen?',
    answer:
      "In der Schweiz werden folgende Sozialversicherungsbeiträge vom Bruttolohn abgezogen: AHV/IV/EO (ca. 5.3%), ALV (1.1% bis 148'200 CHF Jahreslohn), BVG/Pensionskasse (altersabhängig), NBU (ca. 1-3%) und optional KTG (Krankentaggeldversicherung).",
  },
  {
    question: 'Ist der Brutto Netto Rechner kostenlos?',
    answer:
      'Ja, unser Brutto Netto Rechner ist <strong>100% kostenlos</strong> und kann ohne Registrierung oder Anmeldung genutzt werden. Sie können beliebig viele Berechnungen durchführen.',
  },
  {
    question: 'Gilt der Rechner für alle Kantone in der Schweiz?',
    answer:
      'Ja, die <strong>Sozialversicherungsbeiträge</strong> (AHV, IV, ALV, BVG) sind in der ganzen Schweiz einheitlich. Der Rechner gilt für alle Kantone wie Zürich, Basel, Bern, Luzern, Aargau, St.Gallen, Genf, Waadt und alle weiteren Kantone. Beachten Sie jedoch, dass Steuern kantonal unterschiedlich sind und hier nicht berücksichtigt werden.',
  },
  {
    question: 'Was ist der 13. Monatslohn?',
    answer:
      'Der <strong>13. Monatslohn</strong> ist eine zusätzliche Lohnzahlung, die viele Schweizer Arbeitgeber/innen Ende des Jahres bezahlen. Er entspricht in der Regel einem vollen Monatslohn und ist ebenfalls sozialversicherungspflichtig. In unserem Rechner können Sie aktivieren, ob Sie einen 13. Monatslohn erhalten.',
  },
  {
    question: 'Sind meine Lohndaten bei diesem Rechner sicher?',
    answer: `Ja, <strong>100% sicher</strong>. Alle Berechnungen finden ausschliesslich in Ihrem Browser statt. Ihre Daten werden niemals an einen Server übertragen. Zudem ist der gesamte Quellcode ${link('Open Source auf GitHub')} verfügbar.`,
  },
  {
    question: 'Wer steckt hinter diesem Rechner?',
    answer: `Als ich nach einem Brutto-Netto-Rechner für die Schweiz suchte, fand ich viele Optionen, aber keine, der ich wirklich vertrauen konnte. Bei den meisten Rechnern war mir unklar, was mit meinen Lohndaten passiert. Da keiner Open Source war, konnte ich das nicht nachprüfen. Also habe ich diesen Rechner selbst gebaut: <strong>komplett transparent</strong>, <strong>komplett lokal</strong> und <strong>Open Source</strong>. Der ${link('Code liegt offen auf GitHub.')} Jeder kann ihn prüfen, verbessern oder für eigene Zwecke nutzen.`,
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer.replace(/<[^>]+>/g, '') },
  })),
};
---

<section class="max-w-4xl mx-auto mt-8 mb-8">
  <h2 class="text-2xl font-bold mb-6 text-center">Häufig gestellte Fragen (FAQ)</h2>
  <div class="space-y-4">
    {
      faqs.map(({ question, answer }) => (
        <details class="collapse collapse-plus bg-base-200">
          <summary class="collapse-title text-lg font-medium">{question}</summary>
          <div class="collapse-content">
            <p class="pt-2" set:html={answer} />
          </div>
        </details>
      ))
    }
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
