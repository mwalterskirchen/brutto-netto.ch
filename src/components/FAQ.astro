---
const items = [
  {
    q: 'Welche Abzüge werden in der Schweiz vom Lohn abgezogen?',
    text: 'AHV/IV/EO (5.3%), ALV (1.1% bis 148’200 CHF Jahreslohn, darüber 0.5% Solidaritätssatz), BVG/Pensionskasse (altersabhängig), NBU (1.0%) und optional KTG (0.8%). Kantonale Einkommens- und Quellensteuer sind hier nicht enthalten.',
  },
  {
    q: 'Was ist der 13. Monatslohn?',
    text: 'Eine zusätzliche Lohnzahlung in der Höhe eines Monatslohns, die viele Schweizer Arbeitgeber Ende Jahr zahlen. Er ist sozialversicherungspflichtig. Im Rechner kannst du ihn aktivieren, die Jahresberechnung wechselt dann von 12 auf 13 Monatslöhne.',
  },
  {
    q: 'Sind meine Lohndaten bei diesem Rechner sicher?',
    text: '100% sicher. Alle Berechnungen finden ausschliesslich in deinem Browser statt, keine Daten verlassen dein Gerät. Du kannst das im Network-Panel deines Browsers verifizieren: 0 Requests. Der Quellcode liegt offen auf GitHub.',
  },
  {
    q: 'Wer steckt hinter diesem Rechner?',
    text: 'Als ich nach einem Brutto-Netto-Rechner für die Schweiz suchte, fand ich viele Optionen, aber keinem konnte ich vertrauen. Bei den meisten war unklar, was mit den Lohndaten passiert, und keiner war Open Source. Also habe ich diesen Rechner selbst gebaut: komplett lokal, komplett transparent, vollständig Open Source.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.text },
  })),
};
---

<section class="w-full max-w-5xl mx-auto flex flex-col gap-8" aria-labelledby="faq-heading">
  <header class="flex flex-col gap-2">
    <p class="font-mono text-xs uppercase tracking-widest text-fg-subtle">fragen &amp; antworten</p>
    <h2 id="faq-heading" class="font-sans text-2xl sm:text-3xl md:text-4xl text-fg leading-tight tracking-tight text-balance">
      Was du wissen solltest
    </h2>
  </header>
  <div class="flex flex-col gap-3">
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <div class="faq-body">
          <p>{item.text}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
