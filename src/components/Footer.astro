---
import GitHubIcon from './GitHubIcon.astro';
import { GITHUB_URL } from '../lib/links';
---

<footer class="border-t-2 border-border bg-secondary-background">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>Mit ❤️ us de Schwiz für d'Schwiz</p>
    <nav aria-label="Rechtliches" class="flex flex-wrap items-center gap-x-5 gap-y-2 font-heading">
      <a href="/datenschutz" class="underline-offset-4 hover:underline">
        Datenschutz
      </a>
      <a href="/haftungsausschluss" class="underline-offset-4 hover:underline">
        Haftungsausschluss
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 underline-offset-4 hover:underline"
      >
        <GitHubIcon class="size-4" />
        GitHub
      </a>
    </nav>
  </div>
</footer>
